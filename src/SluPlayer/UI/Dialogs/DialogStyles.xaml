<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dlg="clr-namespace:SluPlayer.UI.Dialogs">

    <!-- Chrome for every SluPlayer dialog (see DialogWindow). -->
    <Style x:Key="Window.SluDialog" TargetType="{x:Type dlg:DialogWindow}">
        <Setter Property="Background" Value="{StaticResource Brush.Bg}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Padding" Value="22,18,22,20" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type dlg:DialogWindow}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Height="44" Background="{StaticResource Brush.Surface1}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,60,0">
                                    <TextBlock Text="{TemplateBinding DialogIcon}" FontFamily="{StaticResource Font.Icons}" FontSize="15"
                                               Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="{TemplateBinding Title}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource Btn.ChromeClose}" Height="44"
                                        Content="{StaticResource Icon.ChromeClose}" ToolTip="닫기 (Esc)"
                                        WindowChrome.IsHitTestVisibleInChrome="True"
                                        Command="{x:Static SystemCommands.CloseWindowCommand}" />
                            </Grid>
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
