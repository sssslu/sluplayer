<UserControl x:Class="SluPlayer.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:st="clr-namespace:SluPlayer.UI.Views.SettingsPage"
             AutomationProperties.Name="설정"
             Focusable="False">

    <UserControl.Resources>
        <Style x:Key="Group" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="{StaticResource FontSize.BodyLarge}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
            <Setter Property="Margin" Value="4,20,0,8" />
        </Style>

        <Style x:Key="GroupCard" TargetType="{x:Type Border}" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="16,0" />
        </Style>

        <!-- One setting: header on the left, its control on the right. The first row of a card sets BorderThickness="0". -->
        <Style x:Key="Row" TargetType="{x:Type HeaderedContentControl}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Padding" Value="0,8" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type HeaderedContentControl}">
                        <Border Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Margin="0,0,16,0" VerticalAlignment="Center"
                                           FontSize="{StaticResource FontSize.BodyLarge}"
                                           Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Choice" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="160" />
            <Setter Property="DisplayMemberPath" Value="Label" />
            <Setter Property="SelectedValuePath" Value="Value" />
        </Style>

        <Style x:Key="Switch" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource CheckBox.Switch}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Status" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Secondary}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <!-- Folder row content: path (middle-shortened, full path in the tooltip) + [변경]. -->
        <Style x:Key="PathText" TargetType="{x:Type st:PathLabel}">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Focusable="False">
        <StackPanel Margin="24,4,24,24" MaxWidth="720">

            <!-- ============================== 일반 ============================== -->
            <TextBlock Style="{StaticResource Group}" Text="일반" />
            <Border Style="{StaticResource GroupCard}">
                <StackPanel>
                    <HeaderedContentControl Style="{StaticResource Row}" Header="항상 위" BorderThickness="0">
                        <ComboBox Style="{StaticResource Choice}" ItemsSource="{Binding OnTopChoices}" SelectedValue="{Binding OnTop}"
                                  AutomationProperties.Name="항상 위" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource Row}" Header="이어 보기">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ResumePlayback}" AutomationProperties.Name="이어 보기" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource Row}" Header="영상 크기에 맞춰 창 조절">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AutoFitWindow}" AutomationProperties.Name="영상 크기에 맞춰 창 조절" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource Row}" Header="파일 연결">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Status}" Text="{Binding AssociationStatus}" AutomationProperties.Name="파일 연결 상태" />
                            <Button Style="{StaticResource Btn.Secondary}" Content="등록" Command="{Binding RegisterAssociationsCommand}"
                                    AutomationProperties.Name="파일 연결 등록" />
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>
            </Border>

            <!-- ============================== 재생 ============================== -->
            <TextBlock Style="{StaticResource Group}" Text="재생" />
            <Border Style="{StaticResource GroupCard}">
                <StackPanel>
                    <HeaderedContentControl Style="{StaticResource Row}" Header="하드웨어 가속" BorderThickness="0">
                        <ComboBox Style="{StaticResource Choice}" ItemsSource="{Binding HwdecChoices}" SelectedValue="{Binding Hwdec}"
                                  AutomationProperties.Name="하드웨어 가속" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource Row}" Header="자막 크기">
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="SubSizeSlider" Width="160" Minimum="10" Maximum="120" SmallChange="1" LargeChange="5" TickFrequency="1"
                                    IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="자막 크기"
                                    Value="{Binding SubtitleFontSize, Delay=150}" />
                            <TextBlock Width="32" Margin="8,0,0,0" TextAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.TextSecondary}" Typography.NumeralAlignment="Tabular"
                                       Text="{Binding Value, ElementName=SubSizeSlider, StringFormat={}{0:0}}" />
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource Row}" Header="스크린샷 폴더" HorizontalContentAlignment="Stretch">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Secondary}" Margin="12,0,0,0" Content="변경"
                                    Command="{Binding BrowseScreenshotDirCommand}" AutomationProperties.Name="스크린샷 폴더 변경" />
                            <st:PathLabel Style="{StaticResource PathText}" Path="{Binding ScreenshotDir}" AutomationProperties.Name="스크린샷 폴더" />
                        </DockPanel>
                    </HeaderedContentControl>
                </StackPanel>
            </Border>

            <!-- ============================== 다운로드 ============================== -->
            <TextBlock Style="{StaticResource Group}" Text="다운로드" />
            <Border Style="{StaticResource GroupCard}">
                <StackPanel>
                    <HeaderedContentControl Style="{StaticResource Row}" Header="동영상 폴더" HorizontalContentAlignment="Stretch" BorderThickness="0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Secondary}" Margin="12,0,0,0" Content="변경"
                                    Command="{Binding BrowseDownloadDirCommand}" AutomationProperties.Name="동영상 폴더 변경" />
                            <st:PathLabel Style="{StaticResource PathText}" Path="{Binding DownloadDir}" AutomationProperties.Name="동영상 폴더" />
                        </DockPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource Row}" Header="오디오 폴더" HorizontalContentAlignment="Stretch">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Secondary}" Margin="12,0,0,0" Content="변경"
                                    Command="{Binding BrowseAudioDownloadDirCommand}" AutomationProperties.Name="오디오 폴더 변경" />
                            <st:PathLabel Style="{StaticResource PathText}" Path="{Binding AudioDownloadDir}" AutomationProperties.Name="오디오 폴더" />
                        </DockPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource Row}" Header="기본 화질">
                        <ComboBox Style="{StaticResource Choice}" ItemsSource="{Binding DownloadQualityChoices}" SelectedValue="{Binding DownloadQuality}"
                                  AutomationProperties.Name="기본 화질" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource Row}" Header="YouTube 계정">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Status}" Text="{Binding YouTubeStatus}" AutomationProperties.Name="YouTube 계정 상태" />
                            <Button Style="{StaticResource Btn.Secondary}" Content="{Binding YouTubeAction}" Command="{Binding YouTubeAccountCommand}"
                                    AutomationProperties.Name="{Binding YouTubeAction, StringFormat='YouTube {0}'}" />
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>
            </Border>

            <!-- ============================== 정보 ============================== -->
            <TextBlock Style="{StaticResource Group}" Text="정보" />
            <Border Style="{StaticResource GroupCard}">
                <HeaderedContentControl Style="{StaticResource Row}" Header="버전" BorderThickness="0">
                    <TextBlock Style="{StaticResource Status}" Margin="0" Text="{Binding AppVersion}" AutomationProperties.Name="버전" />
                </HeaderedContentControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
