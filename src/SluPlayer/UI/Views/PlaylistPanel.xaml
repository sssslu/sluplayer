<UserControl x:Class="SluPlayer.UI.Views.PlaylistPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vp="clr-namespace:SluPlayer.UI.Views.Player"
             Focusable="False"
             AllowDrop="True">
    <UserControl.Resources>
        <!-- Row container: hover / selection backgrounds, tint for the current entry. -->
        <Style x:Key="PanelItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Inset}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Grid Background="Transparent">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Medium}" />
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentSubtle}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Surface3}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Surface4}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="PlaylistItemTemplate" DataType="{x:Type vp:PlaylistItemViewModel}">
            <Grid Height="38" Margin="6,0,12,0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Number" Text="{Binding NumberText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="{StaticResource FontSize.Small}" Foreground="{StaticResource Brush.TextTertiary}"
                           Typography.NumeralAlignment="Tabular" />
                <TextBlock x:Name="CurrentGlyph" Text="{StaticResource Icon.Play}" FontFamily="{StaticResource Font.Icons}" FontSize="12"
                           Foreground="{StaticResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                <TextBlock x:Name="TitleText" Grid.Column="1" Text="{Binding Title}" Margin="2,0,0,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding DurationText}" Margin="10,0,0,0" VerticalAlignment="Center"
                           FontSize="{StaticResource FontSize.Caption}" Foreground="{StaticResource Brush.TextSecondary}"
                           Typography.NumeralAlignment="Tabular" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="CurrentGlyph" Property="Visibility" Value="Visible" />
                    <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="ToolbarIcon" TargetType="{x:Type Button}" BasedOn="{StaticResource Btn.Icon}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource Brush.Surface1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1,0,0,0">
        <DockPanel>
            <!-- Header: title + count, add, clear, close -->
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                <Grid Height="48" Margin="16,0,6,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="재생목록" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="CountText" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="{StaticResource FontSize.Small}"
                                   Foreground="{StaticResource Brush.TextTertiary}" Typography.NumeralAlignment="Tabular" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource ToolbarIcon}" Content="{StaticResource Icon.Add}" ToolTip="파일 추가" Click="Add_Click" />
                        <Button x:Name="ClearButton" Style="{StaticResource ToolbarIcon}" Content="{StaticResource Icon.Delete}" ToolTip="목록 비우기"
                                Click="Clear_Click" Margin="2,0,0,0" />
                        <Button Style="{StaticResource ToolbarIcon}" Content="{StaticResource Icon.Close}" FontSize="12" ToolTip="닫기 (Ctrl+L)"
                                Click="Close_Click" Margin="2,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid>
                <ListBox x:Name="PlaylistList" Padding="6,6,6,10" SelectionMode="Extended" AllowDrop="True"
                         ItemContainerStyle="{StaticResource PanelItemStyle}" ItemTemplate="{StaticResource PlaylistItemTemplate}"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="PlaylistList_MouseDoubleClick" KeyDown="PlaylistList_KeyDown"
                         PreviewMouseLeftButtonDown="PlaylistList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="PlaylistList_PreviewMouseMove"
                         PreviewMouseLeftButtonUp="PlaylistList_PreviewMouseLeftButtonUp"
                         DragEnter="PlaylistList_DragOver" DragOver="PlaylistList_DragOver" DragLeave="PlaylistList_DragLeave"
                         Drop="PlaylistList_Drop" ContextMenuOpening="PlaylistList_ContextMenuOpening">
                    <ListBox.ContextMenu>
                        <ContextMenu />
                    </ListBox.ContextMenu>
                </ListBox>

                <!-- Drop position marker for drag & drop reordering. -->
                <Canvas IsHitTestVisible="False">
                    <Grid x:Name="DropMarker" Height="10" Visibility="Collapsed">
                        <Border Height="2" CornerRadius="1" Background="{StaticResource Brush.Accent}" VerticalAlignment="Center" Margin="4,0,0,0" />
                        <Ellipse Width="8" Height="8" HorizontalAlignment="Left" StrokeThickness="2" Stroke="{StaticResource Brush.Accent}"
                                 Fill="{StaticResource Brush.Surface1}" />
                    </Grid>
                </Canvas>

                <TextBlock x:Name="EmptyText" Text="비어 있음" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,60"
                           Foreground="{StaticResource Brush.TextTertiary}" IsHitTestVisible="False" Visibility="Collapsed" />
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
