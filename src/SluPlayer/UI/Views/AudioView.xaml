<UserControl x:Class="SluPlayer.UI.Views.AudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             ClipToBounds="True">
    <Grid Background="{StaticResource Brush.Bg}">
        <!-- Kept clear of the top bar (64) and control bar (112) overlays. -->
        <Grid x:Name="SafeArea" Margin="24,64,24,112">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- The native video window (mpv draws the embedded cover) is placed exactly over this square. -->
                <Border x:Name="CoverSlotElement" Width="320" Height="320" HorizontalAlignment="Center" Background="Black" Visibility="Collapsed" />
                <TextBlock x:Name="MusicGlyph" Text="{StaticResource Icon.Music}" FontFamily="{StaticResource Font.Icons}" FontSize="56"
                           Foreground="{StaticResource Brush.TextTertiary}" HorizontalAlignment="Center" />
                <TextBlock x:Name="TitleText" Margin="0,22,0,0" FontSize="22" FontWeight="SemiBold" TextAlignment="Center"
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Brush.Text}" />
                <TextBlock x:Name="ArtistText" Margin="0,6,0,0" FontSize="{StaticResource FontSize.Subtitle}" TextAlignment="Center"
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Brush.TextSecondary}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
