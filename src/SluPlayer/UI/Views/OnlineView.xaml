<UserControl x:Class="SluPlayer.UI.Views.OnlineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SluPlayer.UI"
             xmlns:on="clr-namespace:SluPlayer.UI.Views.Online"
             xmlns:vmo="clr-namespace:SluPlayer.ViewModels.Online"
             xmlns:dl="clr-namespace:SluPlayer.Services.Downloads"
             Background="{StaticResource Brush.Bg}"
             Foreground="{StaticResource Brush.Text}"
             FontFamily="{StaticResource Font.UI}"
             FontSize="{StaticResource FontSize.Body}"
             AutomationProperties.AutomationId="OnlineView">

    <UserControl.Resources>
        <ui:BoolToVisibilityConverter x:Key="Vis" />
        <on:DownloadStateBrushConverter x:Key="StateBrush" />
        <on:KindGlyphConverter x:Key="KindGlyph" />

        <!-- ================= small styles ================= -->
        <Style x:Key="Caption" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextTertiary}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Label" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="Chip" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource Radio.Chip}">
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="12,3" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
        </Style>

        <Style x:Key="SmallButton" TargetType="{x:Type Button}" BasedOn="{StaticResource Btn.Secondary}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="12,3" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
        </Style>

        <Style x:Key="SmallPrimary" TargetType="{x:Type Button}" BasedOn="{StaticResource Btn.Primary}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="12,3" />
            <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
        </Style>

        <Style x:Key="SmallLink" TargetType="{x:Type Button}" BasedOn="{StaticResource Btn.Link}">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
            <Setter Property="Margin" Value="12,0,0,0" />
        </Style>

        <Style x:Key="ItemAction" TargetType="{x:Type Button}" BasedOn="{StaticResource Btn.Icon}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="Glyph" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextTertiary}" />
        </Style>

        <Style x:Key="Badge" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource Brush.Surface4}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,0,6,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextElement.FontSize" Value="{StaticResource FontSize.Caption}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.TextSecondary}" />
        </Style>

        <!-- List item without selection chrome (rows draw their own background). -->
        <Style x:Key="PlainItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= choices shared by both cards ================= -->
        <DataTemplate x:Key="OptionsTemplate" DataType="{x:Type vmo:DownloadOptionsViewModel}">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,6">
                        <TextBlock Text="종류" Style="{StaticResource Label}" />
                        <RadioButton x:Name="KindVideo" Style="{StaticResource Chip}" Content="영상" IsChecked="{Binding IsVideo}" />
                        <RadioButton x:Name="KindAudio" Style="{StaticResource Chip}" Content="음악" IsChecked="{Binding IsAudio}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,6" Visibility="{Binding ShowQuality, Converter={StaticResource Vis}}">
                        <TextBlock Text="화질" Style="{StaticResource Label}" />
                        <ComboBox x:Name="QualityBox" ItemsSource="{Binding Qualities}" SelectedItem="{Binding SelectedQuality}" DisplayMemberPath="Label"
                                  MinWidth="132" MinHeight="28" Padding="10,3,30,3" FontSize="{StaticResource FontSize.Small}" AutomationProperties.Name="화질" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,6">
                        <TextBlock Text="형식" Style="{StaticResource Label}" />
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsVideo, Converter={StaticResource Vis}}">
                            <RadioButton x:Name="FormatMp4" Style="{StaticResource Chip}" Content="MP4" IsChecked="{Binding IsMp4}" />
                            <RadioButton x:Name="FormatMkv" Style="{StaticResource Chip}" Content="MKV" IsChecked="{Binding IsMkv}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsAudio, Converter={StaticResource Vis}}">
                            <RadioButton x:Name="AudioMp3" Style="{StaticResource Chip}" Content="MP3" IsChecked="{Binding IsMp3}" />
                            <RadioButton x:Name="AudioM4a" Style="{StaticResource Chip}" Content="M4A" IsChecked="{Binding IsM4a}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Height="28" Margin="0,0,0,6">
                        <TextBlock Text="저장" Style="{StaticResource Label}" />
                        <TextBlock x:Name="OutputDirText" Text="{Binding OutputDirText}" ToolTip="{Binding OutputDirText}" Style="{StaticResource Caption}"
                                   Foreground="{StaticResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                        <Button x:Name="ChangeFolderButton" Style="{StaticResource SmallLink}" Content="변경" Margin="8,0,0,0"
                                Command="{Binding ChangeFolderCommand}" AutomationProperties.Name="저장 폴더 변경" />
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </DataTemplate>

        <!-- ================= single video ================= -->
        <DataTemplate x:Key="VideoCardTemplate" DataType="{x:Type vmo:VideoAnalysisViewModel}">
            <Border Style="{StaticResource Card}" Padding="12" AutomationProperties.AutomationId="VideoCard">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="160" Height="90" VerticalAlignment="Top">
                        <Border CornerRadius="6" Background="{StaticResource Brush.Surface4}">
                            <TextBlock Text="{StaticResource Icon.Video}" Style="{StaticResource Glyph}" FontSize="24" />
                        </Border>
                        <Border CornerRadius="6" on:RemoteImage.Url="{Binding ThumbnailUrl}" on:RemoteImage.DecodeWidth="320" />
                    </Grid>
                    <DockPanel Grid.Column="1" Margin="14,0,0,0">
                        <DockPanel DockPanel.Dock="Top">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.IconSmall}" Content="{StaticResource Icon.Close}" VerticalAlignment="Top"
                                    Margin="8,-4,-4,0" ToolTip="닫기" AutomationProperties.Name="닫기"
                                    Command="{Binding DataContext.CloseAnalysisCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <TextBlock x:Name="VideoTitle" Text="{Binding Title}" FontWeight="SemiBold" FontSize="{StaticResource FontSize.BodyLarge}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding MetaText}" Style="{StaticResource Caption}" Margin="0,2,0,8" TextTrimming="CharacterEllipsis" />
                        <Button x:Name="DownloadButton" DockPanel.Dock="Right" Style="{StaticResource Btn.Primary}" Content="다운로드" MinWidth="104"
                                VerticalAlignment="Bottom" Margin="12,0,0,0" Command="{Binding DownloadCommand}" />
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource OptionsTemplate}" Focusable="False" IsTabStop="False" />
                    </DockPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ================= playlist ================= -->
        <DataTemplate x:Key="EntryTemplate" DataType="{x:Type vmo:PlaylistEntryViewModel}">
            <Grid Height="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsSelected}" Visibility="{Binding IsVideo, Converter={StaticResource Vis}}" AutomationProperties.Name="{Binding Title}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Index}" Style="{StaticResource Caption}" MinWidth="28" Typography.NumeralAlignment="Tabular" />
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                    </StackPanel>
                </CheckBox>
                <DockPanel Visibility="{Binding IsPlaylist, Converter={StaticResource Vis}}" Margin="28,0,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallLink}" Content="열기" Command="{Binding OpenCommand}" />
                    <TextBlock Text="{StaticResource Icon.Playlist}" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Title}" />
                </DockPanel>
                <TextBlock Grid.Column="1" Text="{Binding DurationText}" Style="{StaticResource Caption}" Margin="12,0,6,0" Typography.NumeralAlignment="Tabular" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PlaylistCardTemplate" DataType="{x:Type vmo:PlaylistAnalysisViewModel}">
            <Border Style="{StaticResource Card}" Padding="12" AutomationProperties.AutomationId="PlaylistCard">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.IconSmall}" Content="{StaticResource Icon.Close}" VerticalAlignment="Center"
                                Margin="8,0,-4,0" ToolTip="닫기" AutomationProperties.Name="닫기"
                                Command="{Binding DataContext.CloseAnalysisCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0"
                                    Visibility="{Binding HasVideos, Converter={StaticResource Vis}}">
                            <Button x:Name="DownloadSelectedButton" Style="{StaticResource Btn.Secondary}" Content="{Binding DownloadSelectedText}"
                                    Command="{Binding DownloadSelectedCommand}" />
                            <Button x:Name="DownloadAllButton" Style="{StaticResource Btn.Primary}" Content="{Binding DownloadAllText}" Margin="8,0,0,0"
                                    Command="{Binding DownloadAllCommand}" />
                        </StackPanel>
                        <TextBlock Text="{StaticResource Icon.Playlist}" Style="{StaticResource Glyph}" FontSize="14" Margin="0,0,8,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="PlaylistTitle" Text="{Binding Title}" FontWeight="SemiBold" FontSize="{StaticResource FontSize.BodyLarge}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                            <TextBlock Text="{Binding MetaText}" Style="{StaticResource Caption}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                    <ContentControl DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource OptionsTemplate}" Focusable="False" IsTabStop="False"
                                    Visibility="{Binding HasVideos, Converter={StaticResource Vis}}" />
                    <Border DockPanel.Dock="Top" Margin="0,4,0,0" Padding="0,6,0,2" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0"
                            Visibility="{Binding HasEntries, Converter={StaticResource Vis}}">
                        <CheckBox x:Name="SelectAllCheck" Content="전체 선택" IsChecked="{Binding AllSelected}" FontSize="{StaticResource FontSize.Small}"
                                  Visibility="{Binding HasVideos, Converter={StaticResource Vis}}" />
                    </Border>
                    <TextBlock DockPanel.Dock="Top" Text="항목 없음" Style="{StaticResource Caption}" Margin="0,10,0,0"
                               Visibility="{Binding HasEntries, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                    <ListBox x:Name="PlaylistEntries" ItemsSource="{Binding Entries}" ItemTemplate="{StaticResource EntryTemplate}"
                             ItemContainerStyle="{StaticResource PlainItem}" Padding="0" MaxHeight="150"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="재생목록 항목"
                             Visibility="{Binding HasEntries, Converter={StaticResource Vis}}" />
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- ================= download list item ================= -->
        <DataTemplate x:Key="ItemTemplate" DataType="{x:Type dl:DownloadItem}">
            <Border Background="{StaticResource Brush.Surface2}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                    CornerRadius="8" Padding="8,6" Margin="0,0,6,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="96" Height="54">
                        <Border CornerRadius="5" Background="{StaticResource Brush.Surface4}">
                            <TextBlock Text="{Binding IsAudio, Converter={StaticResource KindGlyph}}" Style="{StaticResource Glyph}" FontSize="18" />
                        </Border>
                        <Border CornerRadius="5" on:RemoteImage.Url="{Binding ThumbnailUrl}" on:RemoteImage.DecodeWidth="192" />
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Style="{StaticResource Caption}" Margin="8,0,0,0"
                                       Typography.NumeralAlignment="Tabular" />
                            <Border DockPanel.Dock="Left" Style="{StaticResource Badge}" Margin="0,0,8,0">
                                <TextBlock Text="{Binding PresetLabel}" />
                            </Border>
                            <TextBlock x:Name="StatusText" Text="{Binding DetailText}" FontSize="{StaticResource FontSize.Small}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding DetailText}" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"
                                       Foreground="{Binding State, Converter={StaticResource StateBrush}, ConverterParameter=text}" />
                        </DockPanel>
                        <ProgressBar Margin="0,6,0,0" Height="4" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                     Foreground="{Binding State, Converter={StaticResource StateBrush}}"
                                     Visibility="{Binding ShowProgress, Converter={StaticResource Vis}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="LoginAction" Style="{StaticResource SmallPrimary}" Content="로그인" Margin="0,0,4,0"
                                Visibility="{Binding ShowLoginAction, Converter={StaticResource Vis}}"
                                Command="{Binding DataContext.LoginCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <Button x:Name="PlayAction" Style="{StaticResource ItemAction}" Content="{StaticResource Icon.Play}" ToolTip="재생"
                                AutomationProperties.Name="재생" Visibility="{Binding CanPlay, Converter={StaticResource Vis}}"
                                Command="{Binding DataContext.PlayItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        <Button x:Name="FolderAction" Style="{StaticResource ItemAction}" Content="{StaticResource Icon.FolderOpen}" ToolTip="폴더 열기"
                                AutomationProperties.Name="폴더 열기" Visibility="{Binding IsCompleted, Converter={StaticResource Vis}}"
                                Command="{Binding DataContext.OpenItemFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        <Button x:Name="PauseAction" Style="{StaticResource ItemAction}" Content="{StaticResource Icon.Pause}" ToolTip="일시정지"
                                AutomationProperties.Name="일시정지" Visibility="{Binding CanPause, Converter={StaticResource Vis}}"
                                Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        <Button x:Name="ResumeAction" Style="{StaticResource ItemAction}" Content="{StaticResource Icon.Play}" ToolTip="계속"
                                AutomationProperties.Name="계속" Visibility="{Binding CanResume, Converter={StaticResource Vis}}"
                                Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        <Button x:Name="RetryAction" Style="{StaticResource ItemAction}" Content="{StaticResource Icon.Refresh}" ToolTip="다시 시도"
                                AutomationProperties.Name="다시 시도" Visibility="{Binding CanRetry, Converter={StaticResource Vis}}"
                                Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        <Button x:Name="CancelAction" Style="{StaticResource ItemAction}" Content="{StaticResource Icon.Cancel}" ToolTip="취소"
                                AutomationProperties.Name="취소" Visibility="{Binding CanCancel, Converter={StaticResource Vis}}"
                                Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        <Button x:Name="RemoveAction" Style="{StaticResource ItemAction}" Content="{StaticResource Icon.Delete}" ToolTip="지우기"
                                AutomationProperties.Name="지우기" Visibility="{Binding IsFinished, Converter={StaticResource Vis}}"
                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ link ============ -->
        <Grid Margin="16,14,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="UrlBox" Text="{Binding UrlText, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" Tag="동영상 링크"
                     AutomationProperties.Name="링크">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding AnalyzeCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button x:Name="PasteButton" Grid.Column="1" Margin="8,0,0,0" MinHeight="36" Style="{StaticResource Btn.Secondary}" Content="붙여넣기"
                    Command="{Binding PasteCommand}" />
            <Button x:Name="AnalyzeButton" Grid.Column="2" Margin="8,0,0,0" MinHeight="36" MinWidth="76" Style="{StaticResource Btn.Primary}" Content="분석"
                    Command="{Binding AnalyzeCommand}" />
        </Grid>

        <!-- ============ status lines: analysing, playlist choice, messages (stacked: they can show together) ============ -->
        <StackPanel Grid.Row="1" Margin="16,0,16,0">
            <DockPanel x:Name="AnalyzingLine" Margin="0,10,0,0" Visibility="{Binding IsAnalyzing, Converter={StaticResource Vis}}">
                <Button x:Name="CancelAnalysisButton" DockPanel.Dock="Right" Style="{StaticResource SmallLink}" Content="취소"
                        Command="{Binding CancelAnalysisCommand}" />
                <TextBlock Text="분석 중…" Style="{StaticResource Caption}" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,12,0" />
                <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Center" />
            </DockPanel>
            <StackPanel x:Name="PlaylistChoiceLine" Orientation="Horizontal" Margin="0,10,0,0"
                        Visibility="{Binding HasPlaylistChoice, Converter={StaticResource Vis}}">
                <TextBlock Text="재생목록의 영상" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button x:Name="VideoOnlyButton" Style="{StaticResource SmallPrimary}" Content="이 영상만" Command="{Binding VideoOnlyCommand}" />
                <Button x:Name="WholePlaylistButton" Style="{StaticResource SmallButton}" Content="재생목록 전체" Margin="6,0,0,0"
                        Command="{Binding WholePlaylistCommand}" />
            </StackPanel>
            <DockPanel x:Name="MessageLine" Margin="0,10,0,0" Visibility="{Binding Message, Converter={StaticResource Vis}}">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MessageLoginButton" Style="{StaticResource SmallPrimary}" Content="로그인" Margin="12,0,0,0"
                            Visibility="{Binding MessageNeedsLogin, Converter={StaticResource Vis}}" Command="{Binding LoginCommand}" />
                    <Button x:Name="RetryAnalysisButton" Style="{StaticResource SmallButton}" Content="다시 시도" Margin="6,0,0,0"
                            Visibility="{Binding CanRetryAnalysis, Converter={StaticResource Vis}}" Command="{Binding RetryAnalysisCommand}" />
                </StackPanel>
                <TextBlock x:Name="MessageText" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </StackPanel>

        <!-- ============ analysis result ============ -->
        <ContentControl x:Name="VideoCard" Grid.Row="2" Margin="16,10,16,0" Content="{Binding Video}" ContentTemplate="{StaticResource VideoCardTemplate}"
                        Focusable="False" IsTabStop="False" Visibility="{Binding Video, Converter={StaticResource Vis}}" />
        <ContentControl x:Name="PlaylistCard" Grid.Row="2" Margin="16,10,16,0" Content="{Binding Playlist}" ContentTemplate="{StaticResource PlaylistCardTemplate}"
                        Focusable="False" IsTabStop="False" Visibility="{Binding Playlist, Converter={StaticResource Vis}}" />

        <!-- ============ download list ============ -->
        <DockPanel Grid.Row="3" Margin="16,14,10,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,6,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ResumeAllButton" Style="{StaticResource SmallLink}" Content="모두 계속" Command="{Binding ResumeAllCommand}"
                            Visibility="{Binding CanResumeAll, Converter={StaticResource Vis}}" />
                    <Button x:Name="ClearFinishedButton" Style="{StaticResource SmallLink}" Content="완료 지우기" Command="{Binding ClearFinishedCommand}"
                            Visibility="{Binding CanClearFinished, Converter={StaticResource Vis}}" />
                    <Button x:Name="OpenFolderButton" Style="{StaticResource SmallLink}" Content="폴더 열기" Command="{Binding OpenDownloadFolderCommand}" />
                </StackPanel>
                <TextBlock Text="다운로드 목록" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="ListSummary" Text="{Binding ListSummary}" Style="{StaticResource Caption}" Margin="10,0,0,0" />
            </DockPanel>
            <ListBox x:Name="DownloadList" ItemsSource="{Binding Downloads}" ItemTemplate="{StaticResource ItemTemplate}"
                     ItemContainerStyle="{StaticResource PlainItem}" Padding="0"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="다운로드 목록" />
        </DockPanel>

        <!-- ============ footer: sign-in + engine ============ -->
        <Border Grid.Row="4" Margin="0,8,0,0" Background="{StaticResource Brush.Surface1}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0" Padding="16,5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock x:Name="EngineStatus" Text="{Binding EngineStatus}" Style="{StaticResource Caption}" Margin="0,0,12,0"
                               Visibility="{Binding EngineStatus, Converter={StaticResource Vis}}" />
                    <TextBlock x:Name="EngineVersion" Text="{Binding EngineText}" Style="{StaticResource Caption}" />
                    <Button x:Name="UpdateEngineButton" Style="{StaticResource SmallLink}" Content="엔진 업데이트" Command="{Binding UpdateEngineCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                        <Ellipse.Style>
                            <Style TargetType="{x:Type Ellipse}">
                                <Setter Property="Fill" Value="{StaticResource Brush.TextTertiary}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Brush.Success}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock x:Name="LoginState" Text="{Binding LoginText}" Style="{StaticResource Caption}" Foreground="{StaticResource Brush.TextSecondary}" />
                    <Button x:Name="LoginButton" Style="{StaticResource SmallLink}" Content="로그인" Command="{Binding LoginCommand}"
                            Visibility="{Binding IsLoggedIn, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                    <Button x:Name="LogoutButton" Style="{StaticResource SmallLink}" Content="로그아웃" Command="{Binding LogoutCommand}"
                            Visibility="{Binding IsLoggedIn, Converter={StaticResource Vis}}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
