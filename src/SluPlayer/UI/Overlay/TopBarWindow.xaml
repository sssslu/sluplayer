<ov:OverlayWindow x:Class="SluPlayer.UI.Overlay.TopBarWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ov="clr-namespace:SluPlayer.UI.Overlay"
                  Title="SluPlayer Title"
                  FontFamily="{StaticResource Font.UI}"
                  Foreground="White"
                  Width="800" Height="64">
    <ov:OverlayWindow.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource Btn.Overlay}">
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style TargetType="ToggleButton" BasedOn="{StaticResource Toggle.Overlay}">
            <Setter Property="Focusable" Value="False" />
        </Style>
    </ov:OverlayWindow.Resources>

    <Grid x:Name="RootGrid" MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Border Background="{StaticResource Brush.OverlayTopGradient}" />
        <DockPanel Margin="10,4,4,0" VerticalAlignment="Top" Height="44">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="DownloadButton" Content="{StaticResource Icon.Download}" ToolTip="다운로드 (Ctrl+D)" Click="Download_Click" />
                <Button x:Name="SettingsButton" Content="{StaticResource Icon.Settings}" ToolTip="설정 (F5)" Click="Settings_Click" />
                <ToggleButton x:Name="OnTopToggle" Content="{StaticResource Icon.Pin}" ToolTip="항상 위 (Ctrl+T)" Click="OnTop_Click" Margin="8,0,0,0" />
                <Button x:Name="MinButton" Content="{StaticResource Icon.Minimize}" ToolTip="최소화" Click="Min_Click" />
                <Button x:Name="MaxButton" Content="{StaticResource Icon.Maximize}" ToolTip="최대화" Click="Max_Click" />
                <Button x:Name="ExitFsButton" Content="{StaticResource Icon.ExitFullScreen}" ToolTip="전체 화면 종료 (Esc)" Click="ExitFs_Click" Visibility="Collapsed" />
                <Button x:Name="CloseButton" Content="{StaticResource Icon.ChromeClose}" ToolTip="닫기" Click="Close_Click" />
            </StackPanel>

            <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="8,0,12,0">
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SubText" FontSize="11.5" Foreground="#B3FFFFFF" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
            </StackPanel>
        </DockPanel>
    </Grid>
</ov:OverlayWindow>
