<ov:OverlayWindow x:Class="SluPlayer.UI.Overlay.ControlBarWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ov="clr-namespace:SluPlayer.UI.Overlay"
                  xmlns:ctl="clr-namespace:SluPlayer.UI.Controls"
                  Title="SluPlayer Controls"
                  FontFamily="{StaticResource Font.UI}"
                  Foreground="White"
                  Width="800" Height="112">
    <ov:OverlayWindow.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource Btn.Overlay}">
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style TargetType="ToggleButton" BasedOn="{StaticResource Toggle.Overlay}">
            <Setter Property="Focusable" Value="False" />
        </Style>
    </ov:OverlayWindow.Resources>

    <Grid x:Name="RootGrid">
        <Border Background="{StaticResource Brush.OverlayBarGradient}" />

        <Grid VerticalAlignment="Bottom" Margin="14,0,14,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ctl:SeekBar x:Name="Seek" Grid.Row="0" Margin="-4,0,-4,0" Height="24"
                         Maximum="{Binding Duration}"
                         BufferedRanges="{Binding BufferedRanges}"
                         Chapters="{Binding Chapters}" />

            <Grid Grid.Row="1" Height="46">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PlayPauseButton" Style="{StaticResource Btn.OverlayLarge}" Focusable="False"
                            Content="{StaticResource Icon.Play}" ToolTip="재생 (Space)" Click="PlayPause_Click" />
                    <Button x:Name="PrevButton" Content="{StaticResource Icon.Previous}" ToolTip="이전 (PgUp)" Click="Prev_Click" />
                    <Button x:Name="NextButton" Content="{StaticResource Icon.Next}" ToolTip="다음 (PgDn)" Click="Next_Click" />
                    <Button x:Name="VolumeButton" Content="{StaticResource Icon.Volume}" ToolTip="음소거 (M)" Click="Mute_Click" Margin="4,0,0,0" />
                    <Slider x:Name="VolumeSlider" Style="{StaticResource Slider.Volume}" Width="96" Minimum="0" Maximum="150"
                            VerticalAlignment="Center" Focusable="False" IsMoveToPointEnabled="True"
                            ValueChanged="Volume_ValueChanged" />
                    <TextBlock x:Name="VolumeText" Width="38" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11.5" Foreground="#B3FFFFFF" />
                    <TextBlock x:Name="TimeText" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" Cursor="Hand"
                               ToolTip="남은 시간" MouseLeftButtonUp="TimeText_MouseLeftButtonUp"
                               FontFamily="Segoe UI Variable Text, Segoe UI">
                        <Run x:Name="PosRun" Text="0:00" /><Run Text="  /  " Foreground="#80FFFFFF" /><Run x:Name="DurRun" Text="0:00" Foreground="#B3FFFFFF" />
                    </TextBlock>
                </StackPanel>

                <TextBlock x:Name="InfoText" Grid.Column="1" Margin="16,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                           Foreground="#CCFFFFFF" FontSize="12.5" TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SpeedButton" Width="56" ToolTip="재생 속도 (C / X / Z)" Click="Speed_Click">
                        <TextBlock x:Name="SpeedText" Text="1.0x" FontSize="13" FontWeight="SemiBold" FontFamily="{StaticResource Font.UI}" />
                    </Button>
                    <Button x:Name="SubButton" Content="{StaticResource Icon.Subtitles}" ToolTip="자막 (V)" Click="Subtitles_Click" />
                    <Button x:Name="AudioButton" Content="{StaticResource Icon.AudioTrack}" ToolTip="오디오 (B)" Click="Audio_Click" />
                    <Button x:Name="PlaylistButton" Content="{StaticResource Icon.Playlist}" ToolTip="재생목록 (Ctrl+L)" Click="Playlist_Click" />
                    <Button x:Name="FullscreenButton" Content="{StaticResource Icon.FullScreen}" ToolTip="전체 화면 (Enter)" Click="Fullscreen_Click" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Time (and chapter) under the pointer on the seek bar -->
        <Popup x:Name="PreviewPopup" AllowsTransparency="True" Placement="Relative" PlacementTarget="{Binding ElementName=Seek}"
               IsHitTestVisible="False" Focusable="False" PopupAnimation="None">
            <Border Background="#E6101114" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="8" Padding="4">
                <StackPanel>
                    <TextBlock x:Name="PreviewTime" HorizontalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Foreground="White" Margin="6,1,6,1" />
                    <TextBlock x:Name="PreviewChapter" HorizontalAlignment="Center" FontSize="11.5" Foreground="#CCFFFFFF" Margin="6,0,6,2"
                               TextTrimming="CharacterEllipsis" MaxWidth="224" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</ov:OverlayWindow>
