<Window x:Class="SluPlayer.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:SluPlayer.UI.Controls"
        Title="SluPlayer"
        Width="1280" Height="720" MinWidth="520" MinHeight="340"
        WindowStartupLocation="CenterScreen"
        Background="Black"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.UI}"
        FontSize="{StaticResource FontSize.Body}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        AllowDrop="True">

    <!-- No caption: the top bar overlay (TopBarWindow) is the title bar. -->
    <WindowChrome.WindowChrome>
        <WindowChrome x:Name="Chrome"
                      CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0,0,0,1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar" />
    </Window.TaskbarItemInfo>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Receives all mouse input over the video (the native video window is click-through). -->
        <Grid x:Name="VideoSurface" Background="Black" Focusable="False"
              MouseMove="VideoSurface_MouseMove"
              MouseLeftButtonDown="VideoSurface_MouseLeftButtonDown"
              MouseLeftButtonUp="VideoSurface_MouseLeftButtonUp"
              MouseRightButtonUp="VideoSurface_MouseRightButtonUp"
              MouseDown="VideoSurface_MouseDown"
              MouseWheel="VideoSurface_MouseWheel"
              MouseLeave="VideoSurface_MouseLeave">
            <ContentControl x:Name="AudioViewHost" Focusable="False" IsTabStop="False" Visibility="Collapsed" />

            <!-- Nothing loaded: icon, one line (or the last error), open / download. Centred between the overlay bars
                 (the bottom bar takes clicks over its whole height), so the buttons stay clickable in small windows. -->
            <StackPanel x:Name="IdlePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,64,24,112">
                <Image Source="/Assets/logo-64.png" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="IdleText" Margin="0,16,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560"
                           Foreground="{StaticResource Brush.TextSecondary}" FontSize="{StaticResource FontSize.BodyLarge}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <Button x:Name="IdleLoginButton" Style="{StaticResource Btn.Primary}" Content="YouTube 로그인" MinWidth="96" Margin="0,0,8,0"
                            Focusable="False" Visibility="Collapsed" Click="IdleLogin_Click" />
                    <Button Style="{StaticResource Btn.Primary}" Content="열기" MinWidth="96" Focusable="False"
                            ToolTip="파일 열기 (Ctrl+O)" Click="IdleOpen_Click" />
                    <Button Style="{StaticResource Btn.Secondary}" Content="다운로드" MinWidth="96" Margin="8,0,0,0" Focusable="False"
                            ToolTip="다운로드 (Ctrl+D)" Click="IdleDownload_Click" />
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="LoadingText" Text="불러오는 중…" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource Brush.TextSecondary}" FontSize="{StaticResource FontSize.Subtitle}" Visibility="Collapsed" />
        </Grid>

        <ContentControl x:Name="PlaylistPanelHost" Grid.Column="1" Width="340" Focusable="False" IsTabStop="False" Visibility="Collapsed" />

        <!-- Toasts while no video is visible (over video, mpv's OSD shows them). -->
        <StackPanel x:Name="ToastHost" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False" />

        <!-- The one native video window, moved over the video area or the audio cover slot (never hidden, see SyncVideoHost). -->
        <ctl:VideoHost x:Name="Video" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Top" Width="2" Height="2" />
    </Grid>
</Window>
