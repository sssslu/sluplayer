<!--
    SluPlayer design tokens: colors, brushes, fonts, font sizes and corner radii.
    Dark theme only. Merge order: Colors.xaml, Icons.xaml, Controls.xaml.

    Naming:  Color.X  = System.Windows.Media.Color
             Brush.X  = frozen SolidColorBrush (or gradient) built from Color.X
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">

    <!-- ===================================================================== -->
    <!--  Colors                                                                -->
    <!-- ===================================================================== -->

    <!-- Surfaces -->
    <Color x:Key="Color.Bg">#0E1014</Color>
    <Color x:Key="Color.Surface1">#15181E</Color>
    <Color x:Key="Color.Surface2">#1B1F27</Color>
    <Color x:Key="Color.Surface3">#232833</Color>
    <Color x:Key="Color.Surface4">#2C3340</Color>

    <!-- Borders -->
    <Color x:Key="Color.Border">#2A303B</Color>
    <Color x:Key="Color.BorderStrong">#3A4250</Color>

    <!-- Text -->
    <Color x:Key="Color.Text">#F1F3F7</Color>
    <Color x:Key="Color.TextSecondary">#A3ABBA</Color>
    <Color x:Key="Color.TextTertiary">#6E7687</Color>
    <Color x:Key="Color.TextDisabled">#4C5361</Color>

    <!-- Accent (warm orange) -->
    <Color x:Key="Color.Accent">#FF6A33</Color>
    <Color x:Key="Color.AccentHover">#FF8152</Color>
    <Color x:Key="Color.AccentPressed">#E85A26</Color>
    <Color x:Key="Color.AccentSubtle">#33FF6A33</Color>
    <Color x:Key="Color.AccentSubtleHover">#47FF6A33</Color>
    <Color x:Key="Color.AccentText">#FFFFFF</Color>
    <!-- Accent hue with zero alpha: use as the transparent end of accent gradients (no grey fringe). -->
    <Color x:Key="Color.AccentTransparent">#00FF6A33</Color>

    <!-- Status -->
    <Color x:Key="Color.Danger">#FF4D5E</Color>
    <Color x:Key="Color.Success">#2FD27A</Color>
    <Color x:Key="Color.Warning">#FFB020</Color>

    <!-- Video overlay -->
    <Color x:Key="Color.OverlayForeground">#FFFFFF</Color>
    <Color x:Key="Color.OverlayButtonHover">#26FFFFFF</Color>
    <Color x:Key="Color.OverlayButtonPressed">#40FFFFFF</Color>
    <Color x:Key="Color.SeekTrack">#4DFFFFFF</Color>
    <Color x:Key="Color.SeekBuffered">#80FFFFFF</Color>

    <!-- Window chrome (caption buttons) -->
    <Color x:Key="Color.ChromeHover">#1FFFFFFF</Color>
    <Color x:Key="Color.ChromePressed">#14FFFFFF</Color>
    <Color x:Key="Color.ChromeCloseHover">#E81123</Color>
    <Color x:Key="Color.ChromeClosePressed">#F1707A</Color>

    <!-- Misc -->
    <Color x:Key="Color.Shadow">#000000</Color>
    <Color x:Key="Color.ScrollThumb">#4DFFFFFF</Color>
    <Color x:Key="Color.ScrollThumbHover">#80FFFFFF</Color>
    <Color x:Key="Color.ScrollThumbPressed">#B3FFFFFF</Color>
    <Color x:Key="Color.FocusRing">#FF6A33</Color>

    <!-- ===================================================================== -->
    <!--  Brushes (all frozen)                                                  -->
    <!-- ===================================================================== -->

    <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Bg}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface1" Color="{StaticResource Color.Surface1}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface2" Color="{StaticResource Color.Surface2}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface3" Color="{StaticResource Color.Surface3}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface4" Color="{StaticResource Color.Surface4}" po:Freeze="True" />

    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" po:Freeze="True" />

    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="{StaticResource Color.TextTertiary}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="{StaticResource Color.TextDisabled}" po:Freeze="True" />

    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="{StaticResource Color.AccentPressed}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.AccentSubtle" Color="{StaticResource Color.AccentSubtle}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.AccentSubtleHover" Color="{StaticResource Color.AccentSubtleHover}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="{StaticResource Color.AccentText}" po:Freeze="True" />

    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" po:Freeze="True" />

    <!-- Video overlay -->
    <SolidColorBrush x:Key="Brush.OverlayForeground" Color="{StaticResource Color.OverlayForeground}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.OverlayButtonHover" Color="{StaticResource Color.OverlayButtonHover}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.OverlayButtonPressed" Color="{StaticResource Color.OverlayButtonPressed}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.SeekTrack" Color="{StaticResource Color.SeekTrack}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.SeekBuffered" Color="{StaticResource Color.SeekBuffered}" po:Freeze="True" />

    <!-- Bottom control-bar scrim: transparent at the top, 85% black at the bottom (eased, no banding edge). -->
    <LinearGradientBrush x:Key="Brush.OverlayBarGradient" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#0D000000" Offset="0.2" />
        <GradientStop Color="#33000000" Offset="0.4" />
        <GradientStop Color="#73000000" Offset="0.6" />
        <GradientStop Color="#AD000000" Offset="0.8" />
        <GradientStop Color="#D9000000" Offset="1" />
    </LinearGradientBrush>

    <!-- Top title-bar scrim: 70% black at the top, transparent at the bottom (eased). -->
    <LinearGradientBrush x:Key="Brush.OverlayTopGradient" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Color="#B3000000" Offset="0" />
        <GradientStop Color="#8F000000" Offset="0.2" />
        <GradientStop Color="#5E000000" Offset="0.4" />
        <GradientStop Color="#2A000000" Offset="0.6" />
        <GradientStop Color="#0B000000" Offset="0.8" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>

    <!-- Window chrome -->
    <SolidColorBrush x:Key="Brush.ChromeHover" Color="{StaticResource Color.ChromeHover}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.ChromePressed" Color="{StaticResource Color.ChromePressed}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.ChromeCloseHover" Color="{StaticResource Color.ChromeCloseHover}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.ChromeClosePressed" Color="{StaticResource Color.ChromeClosePressed}" po:Freeze="True" />

    <!-- Misc -->
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="{StaticResource Color.ScrollThumb}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="{StaticResource Color.ScrollThumbHover}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.ScrollThumbPressed" Color="{StaticResource Color.ScrollThumbPressed}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.FocusRing" Color="{StaticResource Color.FocusRing}" po:Freeze="True" />

    <!-- Soft shadow drawn under slider thumbs (a radial gradient instead of a DropShadowEffect). -->
    <RadialGradientBrush x:Key="Brush.ThumbShadow" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5" po:Freeze="True">
        <GradientStop Color="#66000000" Offset="0.55" />
        <GradientStop Color="#00000000" Offset="1" />
    </RadialGradientBrush>

    <!-- ===================================================================== -->
    <!--  Typography                                                            -->
    <!-- ===================================================================== -->

    <FontFamily x:Key="Font.UI">Segoe UI Variable Text, Segoe UI, Malgun Gothic</FontFamily>
    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="FontSize.Caption">11</sys:Double>
    <sys:Double x:Key="FontSize.Small">12</sys:Double>
    <sys:Double x:Key="FontSize.Body">13</sys:Double>
    <sys:Double x:Key="FontSize.BodyLarge">14</sys:Double>
    <sys:Double x:Key="FontSize.Subtitle">16</sys:Double>

    <!-- ===================================================================== -->
    <!--  Shape                                                                 -->
    <!-- ===================================================================== -->

    <CornerRadius x:Key="Radius.Small">4</CornerRadius>
    <CornerRadius x:Key="Radius.Medium">6</CornerRadius>
    <CornerRadius x:Key="Radius.Large">10</CornerRadius>

</ResourceDictionary>
