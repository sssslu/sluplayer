<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Per-user setup program for SluPlayer (no admin rights).
    .NET Framework 4.7.2 is part of Windows 10 1803+ and Windows 11, so the setup itself is tiny and
    needs nothing installed. build-installer.ps1 builds it and appends the release zip as payload:
      [SluPlayer.Setup.exe][SluPlayer-<version>-win-x64.zip][32-byte trailer]
    Built by build\publish.ps1 -Installer.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>SluPlayer.Setup</AssemblyName>
    <RootNamespace>SluPlayer.Setup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\src\SluPlayer\Assets\SluPlayer.ico</ApplicationIcon>
    <Product>SluPlayer</Product>
    <Company>slu</Company>
    <Description>SluPlayer Setup</Description>
    <Copyright>Copyright (c) 2026 slu</Copyright>
    <Version>1.0.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Resource Include="..\..\src\SluPlayer\Assets\logo-64.png" Link="Assets\logo-64.png" />
  </ItemGroup>

</Project>
